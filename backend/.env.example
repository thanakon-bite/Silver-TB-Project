# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of storefront origins allowed by CORS (no trailing slash)
FRONTEND_URL=http://localhost:3000
# Set to 1 when running behind a proxy / load balancer (Render, Railway, Nginx…)
TRUST_PROXY=
# Optional: general API rate limit per IP per 15 minutes (default 300)
RATE_LIMIT_MAX=300
# Set to true to disable the background job (order expiry + LINE retry) on extra instances
DISABLE_JOBS=false

# ── Supabase (server only — NEVER put the service role key in the frontend) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (use sk_test_… while developing) ─────────────
STRIPE_SECRET_KEY=sk_test_
# From `stripe listen` (local) or Dashboard → Developers → Webhooks (production)
STRIPE_WEBHOOK_SECRET=whsec_

# ── Orders ──────────────────────────────────────────────
# Flat shipping fee in THB added to every order (0 = free shipping)
SHIPPING_FEE_THB=0
# How long unpaid orders keep stock reserved before they expire (minutes, 5–1440)
ORDER_RESERVATION_MINUTES=30

# ── LINE Official Account (Messaging API) ───────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Optional override: comma-separated LINE group IDs (C…) or user IDs (U…) for admin alerts.
# Leave empty to use the group the OA bot was last added to (captured automatically by the webhook).
LINE_ADMIN_TARGET_IDS=

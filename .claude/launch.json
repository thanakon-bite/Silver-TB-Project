{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "run", "dev"],
      "port": 5000,
      "url": "http://localhost:5000"
    },
    {
      "name": "backend-ui-check",
      "runtimeExecutable": "node",
      "runtimeArgs": ["backend/server.js"],
      "env": { "STRIPE_SECRET_KEY": "sk_test_placeholder_ui_check", "DISABLE_JOBS": "1" },
      "port": 5000,
      "url": "http://localhost:5000"
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "start"],
      "port": 3000
    }
  ]
}

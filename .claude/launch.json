{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".claude/dev-backend.js"
      ],
      "port": 5000,
      "url": "http://localhost:5000"
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "start"
      ],
      "port": 3000
    }
  ]
}